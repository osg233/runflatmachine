---
import { Menu, X, ChevronDown, ArrowRight } from "@lucide/astro";
import { site } from "@/data/site";

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
// Highlight only the first group that contains the current page (some pages appear in two groups).
const activeGroup = site.nav.findIndex((item) =>
  item.href ? isCurrent(item.href) : (item.children ?? []).some((child) => isCurrent(child.href))
);
const groupIsActive = (index: number) => index === activeGroup;
---

<header class="site-header" data-header>
  <div class="top-strip">
    <div class="top-strip-inner">
      <span class="top-strip-tag">NATO-Compatible</span>
      <span class="top-strip-sep" aria-hidden="true">·</span>
      <span class="top-strip-tag">NSN-Assigned</span>
      <span class="top-strip-sep" aria-hidden="true">·</span>
      <span class="top-strip-tag">Workshop · Container · Trailer</span>
      <span class="top-strip-sep" aria-hidden="true">·</span>
      <span class="top-strip-tag">16–27" Rim Range</span>
    </div>
    <a href={site.quoteHref} class="top-strip-rfq">Request Technical Quote <ArrowRight size={12} aria-hidden="true" /></a>
  </div>

  <div class="nav-shell">
    <a href="/" class="brand" aria-label="Run Flat Machine by GM Defensive — home">
      <img src="/assets/logo.png" alt="Run Flat Machine by GM Defensive" width="160" height="69" />
    </a>

    <button class="mobile-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle>
      <Menu class="icon-open" size={22} aria-hidden="true" />
      <X class="icon-close" size={22} aria-hidden="true" />
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation" data-menu>
      {site.nav.map((item, index) =>
        item.children ? (
          <div class:list={["nav-item has-children", groupIsActive(index) && "active"]} data-nav-item>
            <button
              type="button"
              class="nav-trigger"
              aria-expanded="false"
              aria-controls={`nav-panel-${index}`}
              data-nav-trigger
            >
              {item.label}
              <ChevronDown size={14} aria-hidden="true" />
            </button>
            <div class="mega-dropdown" id={`nav-panel-${index}`}>
              <div class="mega-dropdown-inner">
                {item.children.map((child) => (
                  <a href={child.href} class:list={["mega-link", isCurrent(child.href) && "current"]} aria-current={isCurrent(child.href) ? "page" : undefined}>
                    <span class="mega-link-label">{child.label}</span>
                    {child.desc && <span class="mega-link-desc">{child.desc}</span>}
                  </a>
                ))}
              </div>
              <div class="mega-dropdown-cta">
                <span>Need a configuration recommendation?</span>
                <a href={site.quoteHref} class="mega-cta-btn">
                  Request Technical Quote
                  <ArrowRight size={14} aria-hidden="true" />
                </a>
              </div>
            </div>
          </div>
        ) : (
          <div class:list={["nav-item", groupIsActive(index) && "active"]}>
            <a href={item.href} aria-current={item.href && isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
          </div>
        )
      )}

      <a href={site.quoteHref} class="nav-mobile-cta">
        Request Technical Quote
        <ArrowRight size={16} aria-hidden="true" />
      </a>
    </nav>

    <a href={site.quoteHref} class="nav-cta">
      Request Quote
      <ArrowRight size={16} aria-hidden="true" />
    </a>
  </div>
</header>
