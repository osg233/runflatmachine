---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import PostCard from "@/components/PostCard.astro";
import { posts, taxonomyPages } from "@/data/site";

export function getStaticPaths() {
  return taxonomyPages.fusion.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}


---

<BaseLayout
  title="Run-Flat Machine Resources"
  description="Run-flat tire maintenance guides and machine resources from GM Defensive."
  canonical="/blog/"
  noindex
>
  <section class="page-hero" style="--page-image: url('/assets/operation.webp')">
    <div class="container reveal">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/blog/">Blog</a>
      </nav>
      <p class="eyebrow">Resources</p>
      <h1>Run-flat machine resources</h1>
      <p>Maintenance guides, vehicle-specific workflows, and procurement articles for armored fleet operators.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Latest articles" title="Technical resources" />
      <div class="post-grid">
        {posts.slice(0, 6).map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
